[Plymouth Theme]
Name=Night Sky
Description=Boot splash made with Ekpo
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/ekpo-night-v1
ScaleBackgroundImage=true
BackgroundStartColor=0x102030
BackgroundEndColor=0x000000
Transition=none
TransitionDuration=0.0
DialogHorizontalAlignment=0.5
DialogVerticalAlignment=0.5
MessageBelowAnimation=true
HorizontalAlignment=0.5
VerticalAlignment=0.625
ProgressBarBackgroundColor=0x404040
ProgressBarForegroundColor=0xff8800
ProgressBarHorizontalAlignment=0.5
ProgressBarVerticalAlignment=0.904396
ProgressBarWidth=512
ProgressBarHeight=7

[boot-up]
UseAnimation=true
UseProgressBar=true
UseEndAnimation=false
SuppressMessages=true

[shutdown]
UseAnimation=true
UseProgressBar=true
UseEndAnimation=false
SuppressMessages=true

[reboot]
UseAnimation=true
UseProgressBar=true
UseEndAnimation=false
SuppressMessages=true

[updates]
UseAnimation=true
UseProgressBar=true
UseEndAnimation=false
SuppressMessages=true

[system-upgrade]
UseAnimation=true
UseProgressBar=true
UseEndAnimation=false
SuppressMessages=true

[firmware-upgrade]
UseAnimation=true
UseProgressBar=true
UseEndAnimation=false
SuppressMessages=true

[system-reset]
UseAnimation=true
UseProgressBar=true
UseEndAnimation=false
SuppressMessages=true
