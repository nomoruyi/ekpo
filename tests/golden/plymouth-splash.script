# Generated by Ekpo from the design Night Sky, version 2.
# Plymouth's script module, for an animation that loops in 3 s (two-step's loop is 2 s).
# State lives in global.*; callbacks are local scopes.

Window.SetBackgroundTopColor(0.063, 0.125, 0.188);
Window.SetBackgroundBottomColor(0.000, 0.000, 0.000);

global.background_image = Image("background.png");
global.background_sprite = Sprite(global.background_image.Scale(Window.GetWidth(), Window.GetHeight()));
global.background_sprite.SetPosition(Window.GetX(), Window.GetY(), -100);

global.frames[0] = Image("frame-0001.png");
global.frames[1] = Image("frame-0002.png");
global.frames[2] = Image("frame-0003.png");
global.anim_count = 3;
global.anim_ticks = 150;
global.anim_tick = 0;
global.anim_sprite = Sprite(global.frames[0]);
global.anim_sprite.SetPosition(Window.GetX() + Window.GetWidth() * 0.5 - global.frames[0].GetWidth() / 2,
                               Window.GetY() + Window.GetHeight() * 0.6 - global.frames[0].GetHeight() / 2, 10);

fun animation_tick ()
{
  global.anim_tick = global.anim_tick + 1;
  if (global.anim_tick >= global.anim_ticks)
    global.anim_tick = 0;
  global.anim_sprite.SetImage(global.frames[Math.Int(global.anim_tick * global.anim_count / global.anim_ticks)]);
}

global.ticks = 0;

fun refresh_callback ()
{
  global.ticks = global.ticks + 1;
  animation_tick();
}

Plymouth.SetRefreshRate(50);
Plymouth.SetRefreshFunction(refresh_callback);

global.progress_box = Image("progress-box.png");
global.progress_bar = Image("progress-bar.png");
global.progress_box_sprite = Sprite(global.progress_box);
global.progress_box_sprite.SetPosition(Window.GetX() + Window.GetWidth() * 0.4, Window.GetY() + Window.GetHeight() * 0.9, 5);
global.progress_bar_sprite = Sprite();
global.progress_bar_sprite.SetPosition(Window.GetX() + Window.GetWidth() * 0.4, Window.GetY() + Window.GetHeight() * 0.9, 6);

fun boot_progress_callback (duration, progress)
{
  width = Math.Int(global.progress_bar.GetWidth() * progress);
  if (width > 0)
    global.progress_bar_sprite.SetImage(global.progress_bar.Scale(width, global.progress_bar.GetHeight()));
}

Plymouth.SetBootProgressFunction(boot_progress_callback);

global.message_sprite = Sprite();
global.message_sprite.SetZ(20);

fun display_message_callback (text)
{
  if (text == "")
    global.message_sprite.SetOpacity(0);
  else
  {
    image = Image.Text(text, 1, 1, 1);
    global.message_sprite.SetImage(image);
    global.message_sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - image.GetWidth() / 2);
    global.message_sprite.SetY(Window.GetY() + Window.GetHeight() * 0.622778);
    global.message_sprite.SetOpacity(1);
  }
}

fun hide_message_callback (text)
{
  global.message_sprite.SetOpacity(0);
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);

global.lock_image = Image("lock.png");
global.entry_image = Image("entry.png");
global.entry_x = Window.GetX() + Window.GetWidth() / 2 - global.entry_image.GetWidth() / 2;
global.entry_y = Window.GetY() + Window.GetHeight() / 2 - global.entry_image.GetHeight() / 2;
global.dialog_lock = Sprite(global.lock_image);
global.dialog_lock.SetPosition(global.entry_x - global.lock_image.GetWidth() * 1.5,
                               global.entry_y + global.entry_image.GetHeight() / 2 - global.lock_image.GetHeight() / 2, 100);
global.dialog_entry = Sprite(global.entry_image);
global.dialog_entry.SetPosition(global.entry_x, global.entry_y, 100);
global.dialog_prompt = Sprite();
global.dialog_prompt.SetZ(101);
global.dialog_text = Sprite();
global.dialog_text.SetZ(101);

fun set_dialog_opacity (opacity)
{
  global.dialog_lock.SetOpacity(opacity);
  global.dialog_entry.SetOpacity(opacity);
  global.dialog_prompt.SetOpacity(opacity);
  global.dialog_text.SetOpacity(opacity);
}

fun show_dialog (prompt, text)
{
  set_dialog_opacity(1);
  if (prompt == "")
    global.dialog_prompt.SetOpacity(0);
  else
  {
    image = Image.Text(prompt, 1, 1, 1);
    global.dialog_prompt.SetImage(image);
    global.dialog_prompt.SetX(Window.GetX() + Window.GetWidth() / 2 - image.GetWidth() / 2);
    global.dialog_prompt.SetY(global.entry_y - image.GetHeight() * 2);
  }
  if (text == "")
    global.dialog_text.SetOpacity(0);
  else
  {
    image = Image.Text(text, 1, 1, 1);
    global.dialog_text.SetImage(image);
    global.dialog_text.SetX(global.entry_x + global.entry_image.GetHeight() / 2);
    global.dialog_text.SetY(global.entry_y + global.entry_image.GetHeight() / 2 - image.GetHeight() / 2);
  }
}

fun display_normal_callback ()
{
  set_dialog_opacity(0);
}

fun display_password_callback (prompt, bullets)
{
  text = "";
  count = Math.Min(bullets, 40);
  while (count > 0)
  {
    text = text + "•";
    count = count - 1;
  }
  show_dialog(prompt, text);
}

fun display_question_callback (prompt, entry)
{
  show_dialog(prompt, entry);
}

set_dialog_opacity(0);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);
